# Copy this file to `.env` and adjust. All values are optional (defaults shown).

# Interface and port the backend binds to.
HOST=0.0.0.0
PORT=8000

# Auto-reload on code changes (dev). Set to false in production.
RELOAD=true

# Comma-separated list of frontend origins allowed to call this API.
# The static frontend (e.g. GitHub Pages) is a different origin, so list it here.
# Example: ALLOWED_ORIGINS=https://youruser.github.io
ALLOWED_ORIGINS=*
